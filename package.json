{
  "name": "dtc-starter-monorepo",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0",
      "ajv@8": "8.18.0",
      "lodash@4": "4.18.1",
      "qs@6": "6.17.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "@grpc/grpc-js@1": "1.14.5",
      "source-map-js@1": "1.2.2",
      "proxy-addr@2": "2.0.8",
      "follow-redirects@1": "1.16.2",
      "zod@4": "4.6.6",
      "body-parser@1": "1.20.9",
      "postcss-selector-parser@6": "6.1.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.6",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.0.14"
  }
}

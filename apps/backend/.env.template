AUTH_MFA_ENCRYPTION_KEY=
# Server-only Stripe keys. Set both to enable Stripe; use the same sandbox as the storefront.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
DATABASE_URL=
DB_NAME=medusa-backend
# Keep disabled until a real email provider and order.transfer_requested subscriber
# send confirmation tokens ONLY to the original order email and delivery is tested.
ORDER_TRANSFER_EMAIL_ENABLED=false

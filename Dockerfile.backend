FROM node:22-alpine AS base
WORKDIR /server
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate

FROM base AS dependencies
# Only dependency metadata affects this installation layer.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/storefront/package.json ./apps/storefront/package.json
RUN --mount=type=cache,id=channelkhan-pnpm,target=/pnpm/store,sharing=locked \
    pnpm --filter @dtc/backend... install --frozen-lockfile --store-dir /pnpm/store --package-import-method copy

FROM dependencies AS build
COPY apps/backend ./apps/backend
ARG MEDUSA_BACKEND_URL=https://api.mukkys3d.com
ENV MEDUSA_BACKEND_URL=$MEDUSA_BACKEND_URL
RUN pnpm --filter @dtc/backend build

FROM base AS production-dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/storefront/package.json ./apps/storefront/package.json
RUN --mount=type=cache,id=channelkhan-pnpm,target=/pnpm/store,sharing=locked \
    pnpm --filter @dtc/backend... install --prod --frozen-lockfile --store-dir /pnpm/store --package-import-method copy

FROM base AS runtime
WORKDIR /server/apps/backend/.medusa/server
# Preserve pnpm's relative links and the audited lockfile/overrides at runtime.
COPY --from=production-dependencies /server/node_modules /server/node_modules
COPY --from=production-dependencies /server/apps/backend/node_modules /server/apps/backend/node_modules
COPY --from=build /server/apps/backend/.medusa/server/ ./
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=9000
EXPOSE 9000
CMD ["sh", "-c", "../../node_modules/.bin/medusa db:migrate && exec ../../node_modules/.bin/medusa start"]
